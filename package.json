{
  "name": "kalpi-negisha",
  "version": "1.0.0",
  "description": "איתור קלפי נגישה מיוחדת לבחירות לכנסת ה־26",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-pages.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e-prepare.ts && PUBLIC_DIR=public-e2e vite build --outDir dist-e2e --emptyOutDir && tsx scripts/build-pages.ts dist-e2e && playwright test",
    "typecheck": "tsc --noEmit",
    "ingest:files": "tsx scripts/ingest-files.ts",
    "refresh": "tsx scripts/refresh.ts",
    "release": "tsx scripts/build-release.ts",
    "rules:approve": "tsx scripts/approve-rules.ts",
    "rules:record": "tsx scripts/record-rules-verification.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "papaparse": "^5.7.0",
    "proj4": "^2.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
